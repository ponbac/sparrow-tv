{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Playback probe permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [
        { "url": "http://*" },
        { "url": "https://*" }
      ]
    }
  ]
}
